table inet filter { # handle 4
	comment "filter table
}"
	set allowed { # handle 3
		type ipv4_addr
		comment "allowed
hosts"
		elements = { 192.0.2.1 comment "first
host",
			     192.0.2.2 }
	}

	chain input { # handle 1
		comment "input chain
policy accept;"
		type filter hook input priority filter; policy drop;
		ct state established,related accept # handle 4
		tcp dport 443 accept comment "web
}
chain unused {
comment " # handle 5
		tcp dport 22 log prefix "ssh
ip saddr 203.0.113.7 drop # handle 9
" accept # handle 6
		ip saddr 203.0.113.0/24 accept # handle 7
	}

	chain forward { # handle 2
		type filter hook forward priority filter; policy drop;
	}
}
